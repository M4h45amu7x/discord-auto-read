{
    "name": "discord-auto-read",
    "version": "0.1.1",
    "description": "Rule-based automatic read acknowledgements for BetterDiscord.",
    "author": "M4h45amu7x",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/M4h45amu7x/discord-auto-read.git"
    },
    "private": false,
    "packageManager": "bun@1.4.0",
    "scripts": {
        "build": "bun run scripts/build.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun run build"
    },
    "devDependencies": {
        "@betterdiscord/types": "1.14.0",
        "@biomejs/biome": "2.5.10",
        "@types/bun": "1.4.3",
        "@types/react": "19.2.18",
        "typescript": "7.0.2"
    }
}
